# Connectly Root Environment Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL or zero-config fallback)
DATABASE_URL=
DB_SSL=false

# Security
JWT_SECRET=connectly_super_secure_jwt_secret_development_key_2026
JWT_REFRESH_SECRET=connectly_refresh_token_secret_development_key_2026

# Mobile API URL (use your LAN IP for physical device testing, e.g. http://192.168.1.100:5000)
EXPO_PUBLIC_API_URL=http://localhost:5000

PORT=5000
NODE_ENV=development

# Database Configuration
# Leave DATABASE_URL empty to use zero-config embedded persistence engine
# Or provide PostgreSQL URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connectly
DATABASE_URL=
DB_SSL=false

# Authentication Secrets
JWT_SECRET=connectly_super_secure_jwt_secret_development_key_2026
JWT_REFRESH_SECRET=connectly_refresh_token_secret_development_key_2026

# App Settings
MIN_AGE=13

# Media & Storage
CDN_URL=
UPLOAD_MAX_SIZE_MB=50

# Client Origins
CLIENT_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

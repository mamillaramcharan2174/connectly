PORT=5000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL)
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# Supabase API Credentials
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Authentication Secrets
JWT_SECRET=connectly_super_secure_jwt_secret_development_key_2026
JWT_REFRESH_SECRET=connectly_refresh_token_secret_development_key_2026

# App Settings
MIN_AGE=13

# Media & Storage
CDN_URL=
UPLOAD_MAX_SIZE_MB=50

# Client Origins
CLIENT_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000
